Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:includes|scripts|tools|logs|\.github)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "(?i)\.(sql|md|log|zip|jsonl?)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)^(config\.php|database\.sql|upgrade-database\.sql|README\.txt|AUTOMATION_SETUP_GUIDE\.md|PROJECT_COMPLEXITY_REPORT\.md|WINDOWS-CRON-SETUP\.md|video-workflow-edit-enabled\.zip)$">
    Require all denied
</FilesMatch>
